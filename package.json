{
  "name": "@gitgmbh/pi-trinity-mcp",
  "version": "0.1.2",
  "description": "Pi extension that delegates prompts to agents on any self-hosted Trinity MCP platform (HTTP+SSE Streamable transport). Config-less auth via env vars. Surfaces a curated subset of the Trinity MCP tools.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "trinity",
    "mcp",
    "agent-orchestration"
  ],
  "author": "gitgmbh",
  "files": [
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitgmbh/pi-trinity-mcp.git"
  },
  "homepage": "https://github.com/gitgmbh/pi-trinity-mcp#readme",
  "bugs": {
    "url": "https://github.com/gitgmbh/pi-trinity-mcp/issues"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
